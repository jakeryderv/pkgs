# Legacy output locations. Builds now land under PKGS_OUT (default
# ~/.cache/pkgs-jvs), but an old checkout's leftovers must never become
# committable, so these stay ignored.
dist/
build/
repo/
vendor/
gnupg/
.cloudflare/

# 1Password Environments mounts this as a FIFO, which git will not track.
# Listed anyway: if the mount is absent and something writes a real file at
# this path, it becomes committable -- in a public repo.
.env
*.deb
