{
  "rules": [
    {
      "description": "apt metadata: never cache. A stale Packages.gz served against a fresh InRelease produces a hash mismatch and apt exits 100.",
      "expression": "(http.host eq \"pkgs.jvs.sh\" and starts_with(http.request.uri.path, \"/dists/\"))",
      "action": "set_cache_settings",
      "action_parameters": {
        "cache": false
      }
    },
    {
      "description": "apt pool: version-addressed and immutable, cache aggressively at the edge.",
      "expression": "(http.host eq \"pkgs.jvs.sh\" and starts_with(http.request.uri.path, \"/pool/\"))",
      "action": "set_cache_settings",
      "action_parameters": {
        "cache": true,
        "edge_ttl": {
          "mode": "override_origin",
          "default": 31536000
        },
        "browser_ttl": {
          "mode": "override_origin",
          "default": 86400
        }
      }
    }
  ]
}
